{
    "name": "建筑幕墙检测报告工具",
    "short_name": "幕墙检测",
    "description": "建筑幕墙检测数据记录与 Word 报告生成，全部在本机完成，支持离线使用。",
    "lang": "zh-CN",
    "dir": "ltr",
    "id": "/",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait-primary",
    "background_color": "#f5f6f8",
    "theme_color": "#1668dc",
    "icons": [
        {
            "src": "./icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
